#!/bin/bash
# Emulates only the AWS CLI calls the ceremony script makes.
set -uo pipefail
HARNESS="${HARNESS:?}"; STUB="$HARNESS/stub"
echo "aws $*" >> "$STUB/aws.log"

val() { # val <flag> <args...>  -> value after <flag>
  local flag="$1"; shift
  while [ "$#" -gt 0 ]; do
    if [ "$1" = "$flag" ]; then printf '%s' "${2:-}"; return 0; fi
    shift
  done
  printf ''
}

svc="$1 $2"; shift 2
case "$svc" in
  "ssm get-parameter")
    name=$(val --name "$@")
    case "$name" in
      *hsm-admin-password) echo "AdminPass-123" ;;
      *hsm-cu-password)    echo "CuPass-456" ;;
      *commissioning-key)  cat "$STUB/commissioning-key.pem" ;;
      *ceremony/state)     cat "$STUB/state" 2>/dev/null || echo "NOT_STARTED" ;;
      *)                   echo "PENDING-CEREMONY" ;;
    esac
    ;;
  "secretsmanager get-secret-value")
    id=$(val --secret-id "$@")
    case "$id" in
      *hsm-admin*) echo "AdminPass-123" ;;
      *hsm-cu*)    echo "CuPass-456" ;;
      *) echo "stub: unknown secret $id" >&2; exit 1 ;;
    esac
    ;;
  "ssm put-parameter")
    name=$(val --name "$@"); value=$(val --value "$@")
    case "$value" in file://*) value=$(cat "${value#file://}");; esac
    printf '%s=%s\n' "$name" "$(printf '%s' "$value" | head -3 | tr '\n' ' ')" >> "$STUB/ssm-puts.log"
    case "$name" in */ceremony/state) printf '%s' "$value" > "$STUB/state" ;; esac
    ;;
  "cloudhsmv2 describe-clusters")
    query=$(val --query "$@")
    if [[ "$query" == *ClusterCsr* ]]; then
      if [ ! -f "$STUB/cluster.csr" ]; then
        openssl req -new -newkey ec -pkeyopt ec_paramgen_curve:secp384r1 -nodes \
          -keyout "$STUB/cluster-csr-key.pem" -subj "/CN=cluster-csr" \
          -out "$STUB/cluster.csr" 2>/dev/null
      fi
      cat "$STUB/cluster.csr"
    elif [ "${HSM_STUB_UNINITIALIZED:-0}" = "1" ] && [ ! -f "$STUB/claimed" ]; then
      echo UNINITIALIZED
    elif [ ! -f "$STUB/activated" ]; then
      echo INITIALIZED; touch "$STUB/activated"
    else
      echo ACTIVE
    fi
    ;;
  "cloudhsmv2 create-backup")
    echo "backup-stub-0001"
    ;;
  "cloudhsmv2 initialize-cluster")
    signed=$(val --signed-cert "$@"); trust=$(val --trust-anchor "$@")
    signed=${signed#file://}; trust=${trust#file://}
    [ -s "$signed" ] || { echo "stub: missing signed cluster certificate" >&2; exit 1; }
    [ -s "$trust" ]  || { echo "stub: missing trust anchor" >&2; exit 1; }
    # -no_check_time: the certificate was signed in this run; notBefore can be a
    # second ahead of the clock, which a strict verify would reject.
    openssl verify -no_check_time -CAfile "$trust" "$signed" >/dev/null 2>&1 || {
      echo "stub: signed cluster certificate does not chain to the trust anchor" >&2
      exit 1
    }
    echo "initialize-cluster $signed $trust" >> "$STUB/initialize.log"
    touch "$STUB/claimed"
    echo "INITIALIZE_IN_PROGRESS"
    ;;
  "s3api get-object")
    key=$(val --key "$@"); out="${!#}"
    cp "$HARNESS/scripts/$(basename "$key")" "$out"
    ;;
  "s3api put-object")
    key=$(val --key "$@"); body=$(val --body "$@")
    printf '%s %s\n' "$key" "$(wc -c < "$body")" >> "$STUB/s3-puts.log"
    ;;
  *)
    echo "aws stub: unhandled $svc $*" >&2
    exit 1
    ;;
esac
