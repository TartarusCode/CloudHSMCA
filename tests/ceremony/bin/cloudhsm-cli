#!/usr/bin/env python3
"""Emulates `cloudhsm-cli interactive` for the ceremony script harness.

It is a stand-in for an HSM: keys are generated locally (so the harness can sign)
and `crypto sign ecdsa` returns base64(r||s), exactly as the SDK 5 command
reference documents. Nothing else about the flow is stubbed: the ceremony script
parses this JSON, rebuilds the SPKI from the reported EC point, and signs with it.
"""
import base64
import json
import os
import shlex
import sys

from cryptography.hazmat.primitives import hashes, serialization
from cryptography.hazmat.primitives.asymmetric import ec, utils

STUB_DIR = os.environ["STUB_DIR"]
KEY_PATH = os.path.join(STUB_DIR, "hsm_root_key.pem")
LOG = os.path.join(STUB_DIR, "cloudhsm-cli.log")

CURVES = {"secp256r1": ec.SECP256R1, "secp384r1": ec.SECP384R1, "secp521r1": ec.SECP521R1}
HASHES = {"sha256": hashes.SHA256, "sha384": hashes.SHA384, "sha512": hashes.SHA512}


def emit(obj):
    print(json.dumps(obj, indent=2), flush=True)


def load_key():
    if not os.path.exists(KEY_PATH):
        key = ec.generate_private_key(ec.SECP384R1())
        with open(KEY_PATH, "wb") as fh:
            fh.write(key.private_bytes(serialization.Encoding.PEM,
                                       serialization.PrivateFormat.PKCS8,
                                       serialization.NoEncryption()))
    return serialization.load_pem_private_key(open(KEY_PATH, "rb").read(), None)


def der_to_rs(der):
    ints = []
    off = 2 if der[1] < 0x80 else 2 + (der[1] & 0x7F)
    while off < len(der) and len(ints) < 2:
        assert der[off] == 0x02, der[off]
        length = der[off + 1]
        ints.append(der[off + 2:off + 2 + length])
        off += 2 + length
    width = 48
    return b"".join(i.rjust(width, b"\x00")[-width:] for i in ints)


def main():
    argv = sys.argv[1:]
    if argv and argv[0] != "interactive":
        # single-command mode: cloudhsm-cli <command> [options]
        script = " ".join(argv)
    else:
        script = sys.stdin.read()
    with open(LOG, "a") as log:
        log.write("---- session ----\n" + script + "\n")
    for line in script.splitlines():
        line = line.strip()
        if not line or line == "quit":
            continue
        args = shlex.split(line)
        log_line = " ".join(args)

        if args[0] == "login":
            emit({"error_code": 0, "data": {"username": "stub", "role": "x"}})

        elif args[:3] == ["key", "generate-asymmetric-pair", "ec"]:
            curve = CURVES[args[args.index("--curve") + 1]]
            key = ec.generate_private_key(curve())
            with open(KEY_PATH, "wb") as fh:
                fh.write(key.private_bytes(serialization.Encoding.PEM,
                                           serialization.PrivateFormat.PKCS8,
                                           serialization.NoEncryption()))
            point = key.public_key().public_bytes(
                serialization.Encoding.X962, serialization.PublicFormat.UncompressedPoint)
            attrs = {}
            for flag in ("--private-attributes", "--public-attributes"):
                if flag in args:
                    for pair in args[args.index(flag) + 1:]:
                        if "=" not in pair:
                            break
                        k, v = pair.split("=", 1)
                        attrs[(flag, k)] = v
            emit({"error_code": 0, "data": {
                "public_key": {"key-reference": "0x1", "key-info": {}, "attributes": {
                    "key-type": "ec", "class": "public-key",
                    "ec-point": "0x" + point.hex(),
                    "curve": args[args.index("--curve") + 1]}},
                "private_key": {"key-reference": "0x2", "key-info": {}, "attributes": {
                    "key-type": "ec", "class": "private-key",
                    "extractable": attrs.get(("--private-attributes", "extractable"), "true"),
                    "sign": attrs.get(("--private-attributes", "sign"), "false")}},
            }})

        elif args[:3] == ["crypto", "sign", "ecdsa"]:
            data_path = args[args.index("--data-path") + 1]
            hash_name = args[args.index("--hash-function") + 1]
            data_type = args[args.index("--data-type") + 1] if "--data-type" in args else "raw"
            payload = open(data_path, "rb").read()
            key = load_key()
            if data_type == "digest":
                signature = key.sign(payload, ec.ECDSA(utils.Prehashed(HASHES[hash_name]())))
            else:
                signature = key.sign(payload, ec.ECDSA(HASHES[hash_name]()))
            emit({"error_code": 0, "data": {
                "key-reference": "0x2",
                "signature": base64.b64encode(der_to_rs(signature)).decode()}})

        elif args[:2] == ["cluster", "activate"]:
            emit({"error_code": 0, "data": "Cluster activation successful"})

        elif args[:2] == ["user", "create"]:
            emit({"error_code": 0, "data": {"username": args[args.index("--username") + 1],
                                            "role": "crypto-user"}})

        elif args[:2] == ["key", "list"]:
            emit({"error_code": 0, "data": {"keys": []}})

        else:
            log.write("UNHANDLED: %s\n" % log_line)
            emit({"error_code": 1, "error_message": "stub does not implement: %s" % log_line})


if __name__ == "__main__":
    main()
