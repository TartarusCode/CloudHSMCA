#!/bin/bash
# =============================================================================
# AWS CloudHSM Root CA ceremony — cloud-init user data for the ephemeral
# ceremony host (Amazon Linux 2023).
#
# Rendered by ceremony_hsm.tf. The ONLY Terraform interpolation in this file is
# the single JSON document below; every shell expansion is written as $${...}
# so that Terraform does not try to resolve it.
#
# What happens here, in order:
#   1. install CloudHSM Client SDK 5 CLI (cloudhsm-cli), jq, OpenSSL, uv
#   2. python venv with cryptography + boto3 (uv, no system packages mutated)
#   3. point the CLI at the single HSM ENI, wait for the cluster
#   4. activate the cluster, create the crypto user
#   5. generate the Root CA key INSIDE the HSM: extractable=false, sign=true
#   6. rebuild the Root public key from the HSM-reported EC point
#   7. self-sign the Root CA certificate with `cloudhsm-cli crypto sign ecdsa`
#   8. build the Intermediate CSR from the KMS key, sign it with the HSM
#   9. verify the chain and the X.509 profile, publish certs to SSM + S3
#
# Nothing in step 5-8 ever writes a private key to disk. The Root key exists
# only inside the HSM and, after the HSM is deleted in phase 2, only inside the
# automatic encrypted cluster backup that the module denies deleting.
#
# Re-runs: cloud-init executes user data once. A copy is installed at
# /opt/pki/hsm_ceremony.sh so it can be re-run over SSM Session Manager.
# The SSM ceremony/state parameter short-circuits an already-complete ceremony.
# =============================================================================
set -euo pipefail

# SSM RunShellScript starts a bare shell: HOME is unset, so `set -u` aborts on
# the first $HOME use. Default it and a sane PATH before anything else.
export HOME="$${HOME:-/root}"
export PATH="$${PATH:-/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin}"

# --- facts injected by Terraform --------------------------------------------
readonly CONFIG_JSON=$(cat <<'CEREMONY_JSON'
${ceremony_config}
CEREMONY_JSON
)

# --- fixed paths ------------------------------------------------------------
readonly PKI_DIR=/opt/pki
readonly VENV=$PKI_DIR/venv
readonly LOG=/var/log/pki-ceremony.log
readonly CLI=/opt/cloudhsm/bin/cloudhsm-cli
readonly TOOL=$PKI_DIR/kms_ca_tool.py

mkdir -p "$PKI_DIR" "$PKI_DIR/logs" "$(dirname "$LOG")"
chmod 700 "$PKI_DIR"

log() { printf '%s %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$*" | tee -a "$LOG" >&2; }
die() { log "FATAL: $*"; mark_state FAILED || true; exit 1; }
trap 'die "unexpected failure (line $LINENO, exit $?)"' ERR

cfg() { printf '%s' "$CONFIG_JSON" | jq -r --arg k "$1" '.[$k]'; }

NAME=$(cfg name)
REGION=$(cfg region)
CLUSTER_ID=$(cfg cluster_id)
HSM_IP=$${CEREMONY_HSM_IP:-$(cfg hsm_ip)}
BUCKET=$(cfg bucket)
KMS_KEY_ARN=$(cfg kms_key_arn)
ROOT_CURVE=$(cfg root_curve)
ROOT_DIGEST=$(cfg root_digest)
ROOT_LABEL=$(cfg root_label)
PUB_DER=$(cfg public_key_der)
ROOT_DAYS=$(cfg root_validity_days)
INTER_DAYS=$(cfg inter_validity_days)
SSM_ROOT=$(cfg ssm_root_ca_pem)
SSM_INTER=$(cfg ssm_intermediate_pem)
SSM_BUNDLE=$(cfg ssm_ca_bundle_pem)
SSM_STATE=$(cfg ssm_ceremony_state)
SECRET_ADMIN=$(cfg secret_admin_password)
SECRET_CU=$(cfg secret_cu_password)
S3_TOOL=$(cfg s3_kms_ca_tool)
S3_ROOT_CNF=$(cfg s3_root_ca_cnf)
S3_INTER_CNF=$(cfg s3_intermediate_cnf)
CU_USER=$(cfg cu_username)
CLI_RPM=$(cfg cloudhsm_cli_rpm)
CLI_RPM_SHA256=$(cfg cloudhsm_cli_rpm_sha256)
UV_VERSION=$(cfg uv_version)
UV_INSTALLER_SHA256=$(cfg uv_installer_sha256)
S3_TOOL_VERSION=$(cfg s3_tool_version)
S3_ROOT_CNF_VERSION=$(cfg s3_root_cnf_version)
S3_INTER_CNF_VERSION=$(cfg s3_inter_cnf_version)
COMMISSIONING_CA_CERT=$(cfg commissioning_ca_cert)
COMMISSIONING_KEY_PARAM=$(cfg commissioning_key_ssm_param)
COMMISSIONING_SIGNED_CERT=$(cfg commissioning_signed_cert)

export AWS_REGION=$REGION
export AWS_DEFAULT_REGION=$REGION
export PATH="$HOME/.local/bin:$PATH"
# Keep python's stdout in step with the tee'd log so the ceremony transcript
# reads in the order things actually happened.
export PYTHONUNBUFFERED=1

mark_state() { aws ssm put-parameter --name "$SSM_STATE" --value "$1" \
                 --type String --overwrite >/dev/null 2>&1 || true; }

# HSM user passwords: Secrets Manager, scoped to the two secret ARNs.
get_secret() {
  aws secretsmanager get-secret-value --secret-id "$1" \
    --query SecretString --output text
}

# Non-password material (the commissioning signing key) stays a SecureString.
get_ssm_secret() {
  aws ssm get-parameter --name "$1" --with-decryption \
    --query Parameter.Value --output text
}

# CloudHSM CLI prints one JSON document per command; drop the prompt/banner
# lines and keep the last complete document.
pick_json() {
  grep -E '^[[:space:]]*([][{}]|")' | jq -s -c 'last' 2>/dev/null || true
}

# Run one command in cloudhsm-cli interactive mode as the given role.
hsm_as() { # hsm_as <role> <user> <password> <command>
  local out="" attempt
  for attempt in 1 2 3; do
    # --password= form: a generated password may start with '-' and would
    # otherwise be parsed as a flag by the CLI's argument parser.
    # Every session also logs out explicitly: the admin (CO) session that
    # creates the crypto user must not stay open while keys are generated.
    out=$(printf 'login --username %s --role %s --password=%s\n%s\nlogout\nquit\n' \
            "$2" "$1" "$3" "$4" | "$CLI" interactive 2>&1)
    # Retry only transport failures. Retrying a key generation would create a
    # second key, so anything else is returned as-is.
    case "$out" in
      *"Unable to connect"*|*"Connection refused"*|*"connection timed out"*|*"transport error"*)
        if [ "$attempt" -lt 3 ]; then
          log "cloudhsm-cli transient failure (attempt $attempt/3): retrying in 2s"
          sleep 2
          continue
        fi
        ;;
    esac
    break
  done
  printf '%s\n' "$out"
}

hsm_admin() { hsm_as admin admin "$ADMIN_PW" "$1"; }
hsm_cu()    { hsm_as crypto-user "$CU_USER" "$CU_PW" "$1"; }

require_ok() { # require_ok <label> <output-file>
  local code
  code=$(pick_json < "$2" | jq -r '.error_code // "missing"')
  if [ "$code" != "0" ]; then
    log "--- $1 failed (error_code=$code) ---"
    tee -a "$LOG" < "$2" >&2
    die "$1 returned error_code=$code"
  fi
}

log "ceremony start: name=$NAME cluster=$CLUSTER_ID hsm=$HSM_IP region=$REGION"

# --- 0. short-circuit an already completed ceremony -------------------------
if [ "$(aws ssm get-parameter --name "$SSM_STATE" --query Parameter.Value \
        --output text 2>/dev/null || true)" = "COMPLETE" ]; then
  log "ceremony already COMPLETE per $SSM_STATE — nothing to do"
  exit 0
fi

mark_state IN_PROGRESS

# --- 1. packages ------------------------------------------------------------
log "installing jq, openssl, python3.11 and the CloudHSM Client SDK 5 CLI"
# AL2023 ships curl-minimal, which conflicts with the `curl` package; it
# already provides the binary. python3.11 keeps uv from downloading a managed
# interpreter over the network.
dnf install -y -q jq openssl ca-certificates tar gzip python3.11 >/dev/null
[ -n "$CLI_RPM_SHA256" ] && [ "$CLI_RPM_SHA256" != "null" ] \
  || die "cloudhsm_cli_rpm_sha256 is required: refusing to install an unverified CLI package"
curl -fsSL -o /tmp/cloudhsm-cli.rpm "$CLI_RPM"
printf '%s  %s\n' "$CLI_RPM_SHA256" /tmp/cloudhsm-cli.rpm | sha256sum -c - \
  || die "CloudHSM CLI RPM checksum mismatch"
dnf install -y -q /tmp/cloudhsm-cli.rpm >/dev/null
[ -x "$CLI" ] || die "cloudhsm-cli not installed at $CLI"

log "configuring cloudhsm-cli for HSM ENI $HSM_IP"
/opt/cloudhsm/bin/configure-cli -a "$HSM_IP"
# Key availability quorum requires two HSMs; with one, key generation and every
# use of the Root key fail with "key must be available on at least 2 HSMs". Opt
# the client out only when the cluster really has fewer than two.
HSM_COUNT=$(aws cloudhsmv2 describe-clusters --filters clusterIds="$CLUSTER_ID" \
              --query 'length(Clusters[0].Hsms)' --output text 2>/dev/null || echo 1)
if [ "$${HSM_COUNT:-1}" -lt 2 ]; then
  log "cluster has $HSM_COUNT HSM(s): disabling the client key-availability quorum"
  /opt/cloudhsm/bin/configure-cli --disable-key-availability-check
fi
# The client must trust the commissioning CA before any TLS to the HSM,
# including `cluster activate`. This is public certificate material only.
[ -n "$COMMISSIONING_CA_CERT" ] && [ "$COMMISSIONING_CA_CERT" != "null" ] \
  || die "commissioning_ca.certificate is required to trust the HSM cluster"
CCERT="$PKI_DIR/commissioning-ca.pem"
printf '%s\n' "$COMMISSIONING_CA_CERT" > "$CCERT"
install -m 644 "$CCERT" /opt/cloudhsm/etc/customerCA.crt
if systemctl cat cloudhsm-cli >/dev/null 2>&1; then
  systemctl enable --now cloudhsm-cli
  log "cloudhsm-cli service restarted"
else
  log "no cloudhsm-cli systemd unit on this SDK build; the CLI starts its daemon on demand"
fi

# --- 2. python tooling (uv, isolated) ---------------------------------------
if ! command -v uv >/dev/null 2>&1; then
  log "installing uv $UV_VERSION"
  # The versioned installer URL pins the release; the floating URL installs latest.
  curl -LsSf -o /tmp/uv-install.sh "https://astral.sh/uv/$UV_VERSION/install.sh"
  if [ -n "$UV_INSTALLER_SHA256" ] && [ "$UV_INSTALLER_SHA256" != "null" ]; then
    printf '%s  %s\n' "$UV_INSTALLER_SHA256" /tmp/uv-install.sh | sha256sum -c - \
      || die "uv installer checksum mismatch"
  else
    log "WARNING: uv_installer_sha256 is unset; the installer is version-pinned only"
  fi
  sh /tmp/uv-install.sh >/dev/null
  HAVE_UV=$(uv --version | awk '{print $2}')
  [ "$HAVE_UV" = "$UV_VERSION" ] \
    || die "uv $HAVE_UV is installed but uv_version pins $UV_VERSION"
fi
command -v uv >/dev/null 2>&1 || die "uv is unavailable; refusing to fall back to system pip"
log "creating $VENV and installing cryptography + boto3"
uv venv --python 3.11 "$VENV" >/dev/null
uv pip install --python "$VENV/bin/python" "cryptography>=42" "boto3>=1.34" >/dev/null
"$VENV/bin/python" - <<'PY' || die "python crypto stack is not usable"
import boto3, cryptography
print("cryptography", cryptography.__version__, "boto3", boto3.__version__)
PY

log "fetching the CA tooling and rendered OpenSSL profiles from s3://$BUCKET"
s3get() { # s3get <key> <dest> <version-id>
  if [ -n "$3" ] && [ "$3" != "null" ]; then
    aws s3api get-object --bucket "$BUCKET" --key "$1" --version-id "$3" "$2" >/dev/null
  else
    aws s3api get-object --bucket "$BUCKET" --key "$1" "$2" >/dev/null
  fi
}
s3get "$S3_TOOL"      "$TOOL"                      "$S3_TOOL_VERSION"
s3get "$S3_ROOT_CNF"  "$PKI_DIR/root_ca.cnf"       "$S3_ROOT_CNF_VERSION"
s3get "$S3_INTER_CNF" "$PKI_DIR/intermediate_ca.cnf" "$S3_INTER_CNF_VERSION"
chmod 700 "$TOOL"

# --- 3. wait for the cluster, then activate it ------------------------------
STATE=""
for _ in $(seq 1 40); do
  STATE=$(aws cloudhsmv2 describe-clusters --filters clusterIds="$CLUSTER_ID" \
            --query 'Clusters[0].State' --output text 2>/dev/null || echo UNKNOWN)
  case "$STATE" in
    ACTIVE|INITIALIZED|UNINITIALIZED) break ;;
    *) log "cluster state=$STATE — waiting" ; sleep 30 ;;
  esac
done
case "$STATE" in
  ACTIVE|INITIALIZED|UNINITIALIZED) log "cluster state=$STATE" ;;
  *) die "cluster never reached a usable state (last: $STATE)" ;;
esac

# --- 3a. claim a fresh cluster (UNINITIALIZED -> INITIALIZED) ---------------
# A Terraform-created cluster starts UNINITIALIZED and has a cluster CSR. It
# cannot be activated until that CSR is signed by the approved commissioning CA
# and InitializeCluster succeeds. This is the only code path that owns that
# transition; activation below only runs from INITIALIZED/ACTIVE.
if [ "$STATE" = "UNINITIALIZED" ]; then
  log "claiming uninitialized cluster with the commissioning CA"
  CSR=$(aws cloudhsmv2 describe-clusters --filters clusterIds="$CLUSTER_ID" \
          --query 'Clusters[0].Certificates.ClusterCsr' --output text 2>/dev/null || true)
  [ -n "$CSR" ] && [ "$CSR" != "None" ] \
    || die "cluster $CLUSTER_ID is UNINITIALIZED but has no CSR to sign"
  CSR_FILE="$PKI_DIR/cluster.csr"
  CERT_FILE="$PKI_DIR/cluster-cert.pem"
  printf '%s\n' "$CSR" > "$CSR_FILE"

  if [ -n "$COMMISSIONING_SIGNED_CERT" ] && [ "$COMMISSIONING_SIGNED_CERT" != "null" ]; then
    log "using the operator-supplied pre-signed cluster certificate"
    printf '%s\n' "$COMMISSIONING_SIGNED_CERT" > "$CERT_FILE"
  elif [ -n "$COMMISSIONING_KEY_PARAM" ] && [ "$COMMISSIONING_KEY_PARAM" != "null" ]; then
    log "signing the cluster CSR with the commissioning key from SSM"
    COMMISSIONING_KEY=$(get_ssm_secret "$COMMISSIONING_KEY_PARAM")
    [ -n "$COMMISSIONING_KEY" ] || die "commissioning signing key is empty in SSM"
    KEY_FILE="$PKI_DIR/commissioning-key.pem"
    printf '%s\n' "$COMMISSIONING_KEY" > "$KEY_FILE"
    chmod 600 "$KEY_FILE"
    openssl x509 -req -in "$CSR_FILE" -CA "$CCERT" -CAkey "$KEY_FILE" \
      -CAcreateserial -days 375 -sha384 -out "$CERT_FILE" \
      || die "could not sign the cluster CSR with the commissioning CA"
    shred -u "$KEY_FILE" 2>/dev/null || rm -f "$KEY_FILE"
  else
    die "an UNINITIALIZED cluster needs commissioning_ca.key_ssm_param or signed_cluster_certificate"
  fi

  aws cloudhsmv2 initialize-cluster --cluster-id "$CLUSTER_ID" \
    --signed-cert "file://$CERT_FILE" --trust-anchor "file://$CCERT" \
    || die "InitializeCluster failed for $CLUSTER_ID"
  for _ in $(seq 1 40); do
    STATE=$(aws cloudhsmv2 describe-clusters --filters clusterIds="$CLUSTER_ID" \
              --query 'Clusters[0].State' --output text 2>/dev/null || echo UNKNOWN)
    case "$STATE" in
      INITIALIZED|ACTIVE) break ;;
      *) log "cluster state=$STATE after InitializeCluster — waiting" ; sleep 15 ;;
    esac
  done
  case "$STATE" in
    INITIALIZED|ACTIVE) log "cluster claimed: $STATE" ;;
    *) die "cluster never left INITIALIZE_IN_PROGRESS (last: $STATE)" ;;
  esac
fi

ADMIN_PW=$(get_secret "$SECRET_ADMIN")
CU_PW=$(get_secret "$SECRET_CU")
[ -n "$ADMIN_PW" ] && [ -n "$CU_PW" ] || die "ceremony passwords are missing from SSM"

if [ "$STATE" = "INITIALIZED" ]; then
  log "activating the cluster (sets the initial admin password)"
  OUT=$PKI_DIR/logs/activate.json
  "$CLI" cluster activate --password="$ADMIN_PW" > "$OUT" 2>&1 || true
  require_ok "cluster activate" "$OUT"
fi

log "creating crypto user $CU_USER"
OUT=$PKI_DIR/logs/user-create.json
hsm_admin "user create --username $CU_USER --role crypto-user --password=$CU_PW" > "$OUT" 2>&1 || true
if ! pick_json < "$OUT" | jq -e 'select(.error_code == 0)' >/dev/null 2>&1; then
  if grep -qi 'already exists' "$OUT"; then
    log "crypto user already exists — continuing"
  else
    require_ok "user create" "$OUT"
  fi
fi

# --- 4. Root CA key inside the HSM -----------------------------------------
# extractable=false + sign=true are the two attributes that make this a CA key
# that can never leave the HSM. (Some SDK builds also expose
# never-extractable=true; it is stronger but not present on every 5.x build,
# so the module asks for the portable subset.)
# A cluster whose latest backup is restored onto the new HSM already holds the
# Root key. Generating another with the same label would leave two signing keys
# and make `--key-filter attr.label=` ambiguous, so refuse and send the operator
# to the rotation path instead.
EXISTING=$("$CLI" interactive <<EOF 2>&1
login --username $CU_USER --role crypto-user --password=$CU_PW
key list --filter attr.label=$ROOT_LABEL
quit
EOF
)
if printf '%s' "$EXISTING" \
     | grep -Eq "\"label\"[[:space:]]*:[[:space:]]*\"$ROOT_LABEL\""; then
  die "a key labelled $ROOT_LABEL already exists in this cluster (restored backup); run mode=ROTATE_INTERMEDIATE instead of BOOTSTRAP"
fi

log "generating the non-exportable Root CA key (label=$ROOT_LABEL curve=$ROOT_CURVE)"
OUT=$PKI_DIR/logs/root-key.json
# The public half gets a distinct label: a shared label makes
# `crypto sign ecdsa --key-filter attr.label=<label>` match two keys.
hsm_cu "key generate-asymmetric-pair ec --curve $ROOT_CURVE \
  --public-label $${ROOT_LABEL}-pub --private-label $ROOT_LABEL \
  --private-attributes extractable=false sign=true" > "$OUT" 2>&1 || true
require_ok "key generate-asymmetric-pair" "$OUT"

# `jq`'s `//` operator treats a JSON boolean `false` as absent, so the obvious
# `.extractable // "unknown"` turns the required `false` into `"unknown"` and
# aborts a correct ceremony. Require the boolean itself: only literal JSON
# false passes; true, missing and string values all fail here.
if ! pick_json < "$OUT" | jq -e '.data.private_key.attributes.extractable == false' >/dev/null; then
  die "root private key is not confirmed non-extractable (extractable must be the JSON boolean false)"
fi
log "root private key confirmed non-extractable"

POINT=$(pick_json < "$OUT" | jq -r '.data.public_key.attributes."ec-point" // empty')
[ -n "$POINT" ] || die "HSM did not report an EC point for the root public key"

"$VENV/bin/python" "$TOOL" spki-from-point --curve "$ROOT_CURVE" \
  --point "$POINT" --out "$PUB_DER" | tee -a "$LOG"

# --- 5. Root CA certificate, signed by the HSM ------------------------------
export CLOUDHSM_PIN="$CU_USER:$CU_PW"
HSM_ARGS=(--signer hsm --hsm-key-label "$ROOT_LABEL" --hsm-public-key "$PUB_DER"
          --hsm-curve "$ROOT_CURVE" --region "$REGION")

log "self-signing the Root CA certificate ($${ROOT_DAYS}d, $${ROOT_DIGEST})"
"$VENV/bin/python" "$TOOL" self-sign-root "$${HSM_ARGS[@]}" \
  --cnf "$PKI_DIR/root_ca.cnf" --dn-section root_dn --extensions v3_root_ca \
  --days "$ROOT_DAYS" --out "$PKI_DIR/root_ca.pem" | tee -a "$LOG"

# --- 6. Intermediate CSR from KMS, certificate from the HSM -----------------
log "building the Intermediate CSR from the KMS key $(basename "$KMS_KEY_ARN")"
"$VENV/bin/python" "$TOOL" create-intermediate-csr --signer kms \
  --kms-key-id "$KMS_KEY_ARN" --region "$REGION" \
  --cnf "$PKI_DIR/intermediate_ca.cnf" --dn-section intermediate_dn \
  --extensions v3_intermediate_ca --issuer-cert "$PKI_DIR/root_ca.pem" \
  --out "$PKI_DIR/intermediate_ca.csr" | tee -a "$LOG"

log "signing the Intermediate CA certificate with the HSM root ($${INTER_DAYS}d)"
"$VENV/bin/python" "$TOOL" sign-csr "$${HSM_ARGS[@]}" \
  --issuer-cert "$PKI_DIR/root_ca.pem" --csr "$PKI_DIR/intermediate_ca.csr" \
  --cnf "$PKI_DIR/intermediate_ca.cnf" --extensions v3_intermediate_ca \
  --days "$INTER_DAYS" --out "$PKI_DIR/intermediate_ca.pem" | tee -a "$LOG"

# --- 7. verify chain AND profile ------------------------------------------
log "verifying the certificate chain and the X.509 profile"
openssl verify -CAfile "$PKI_DIR/root_ca.pem" "$PKI_DIR/root_ca.pem" | tee -a "$LOG"
openssl verify -CAfile "$PKI_DIR/root_ca.pem" "$PKI_DIR/intermediate_ca.pem" | tee -a "$LOG"

assert_ext() { # assert_ext <pem> <text>
  openssl x509 -in "$1" -noout -text | grep -qF "$2" \
    || die "$1 is missing the required extension text: $2"
  log "  $1: found '$2'"
}
assert_ext "$PKI_DIR/root_ca.pem" "CA:TRUE"
assert_ext "$PKI_DIR/root_ca.pem" "Certificate Sign, CRL Sign"
assert_ext "$PKI_DIR/root_ca.pem" "X509v3 Subject Key Identifier"
assert_ext "$PKI_DIR/root_ca.pem" "X509v3 Authority Key Identifier"
assert_ext "$PKI_DIR/intermediate_ca.pem" "CA:TRUE, pathlen:0"
assert_ext "$PKI_DIR/intermediate_ca.pem" "Certificate Sign, CRL Sign"
openssl x509 -in "$PKI_DIR/root_ca.pem" -noout -checkend 86400 \
  || die "root CA expires within a day"

cat "$PKI_DIR/root_ca.pem" "$PKI_DIR/intermediate_ca.pem" > "$PKI_DIR/ca_bundle.pem"

# --- 8. publish ------------------------------------------------------------
log "publishing certificates to SSM and s3://$BUCKET/certs/"
SSM_ARGS=(--type String --overwrite)
aws ssm put-parameter --name "$SSM_ROOT"   --value "file://$PKI_DIR/root_ca.pem"        "$${SSM_ARGS[@]}"
aws ssm put-parameter --name "$SSM_INTER"  --value "file://$PKI_DIR/intermediate_ca.pem" "$${SSM_ARGS[@]}"
aws ssm put-parameter --name "$SSM_BUNDLE" --value "file://$PKI_DIR/ca_bundle.pem"       "$${SSM_ARGS[@]}"

for f in root_ca.pem intermediate_ca.pem ca_bundle.pem intermediate_ca.csr; do
  aws s3api put-object --bucket "$BUCKET" --key "certs/$f" --body "$PKI_DIR/$f" \
    --server-side-encryption AES256 >/dev/null
done

install -m 700 /var/lib/cloud/instance/user-data.txt "$PKI_DIR/hsm_ceremony.sh"

# Escrow before success: deleting an HSM does NOT create a backup, so the
# backup must be requested while the HSM still holds the Root key. If this
# fails the script dies without COMPLETE, which keeps the HSM alive.
log "requesting the encrypted escrow backup"
# --- 9. HSM token hygiene ---------------------------------------------------
# The backup is restored into every future HSM, so it must contain exactly the
# Root key pair and exactly two users. Temporary wrapping/session keys and stray
# users are removed here; the Root pair is never touched.
log "HSM hygiene: pruning temporary keys and stray users"
KEY_LABELS=$(printf '%s\n' "$(hsm_cu "key list" 2>/dev/null || true)" \
  | grep -o '"label"[[:space:]]*:[[:space:]]*"[^"]*"' \
  | sed 's/.*"\([^"]*\)"$/\1/' | sort -u || true)
for label in $KEY_LABELS; do
  case "$label" in
    temp-*|tmp-*|wrap-*|session-*)
      log "  removing temporary key label=$label"
      hsm_cu "key delete --filter attr.label=$label" >/dev/null 2>&1 \
        || log "  could not delete $label (continuing)" ;;
  esac
done
USERS=$(printf '%s\n' "$(hsm_admin "user list" 2>/dev/null || true)" \
  | grep -o '"username"[[:space:]]*:[[:space:]]*"[^"]*"' \
  | sed 's/.*"\([^"]*\)"$/\1/' | sort -u || true)
for user in $USERS; do
  case "$user" in
    admin|"$CU_USER") ;;
    *)
      log "  removing stray HSM user $user"
      hsm_admin "user delete --username $user" >/dev/null 2>&1 \
        || log "  could not delete $user (continuing)" ;;
  esac
done

# The escrow backup is created by CloudHSM itself when the HSM is deleted; the
# workflow deletes the HSM and then waits for that backup to reach READY.

mark_state COMPLETE

log "CEREMONY COMPLETE"
log "root CA     : $(openssl x509 -in "$PKI_DIR/root_ca.pem" -noout -subject)"
log "root sha256 : $(openssl x509 -in "$PKI_DIR/root_ca.pem" -noout -fingerprint -sha256)"
log "inter sha256: $(openssl x509 -in "$PKI_DIR/intermediate_ca.pem" -noout -fingerprint -sha256)"
log "next step   : apply modules/roles-anywhere — it reads this chain from SSM; the"
log "              workflow deletes the HSM and keeps the encrypted cluster backup"
log "              that holds the root key."
