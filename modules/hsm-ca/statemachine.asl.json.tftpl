{
  "Comment": "CloudHSM Root CA ceremony for a private PKI. BOOTSTRAP creates the non-exportable Root key and signs the Intermediate; ROTATE_INTERMEDIATE restores the cluster backup and re-signs only the Intermediate. The success path publishes the chain to SSM, deletes the HSM, verifies the escrow backup, terminates the host and emits CAChainPublished for whoever consumes the CA. Every failure path deletes the HSM, terminates the host, and re-raises the original cause.",
  "StartAt": "InitializeRun",
  "TimeoutSeconds": 21600,
  "States": {
    "InitializeRun": {
      "Type": "Pass",
      "Comment": "Seed the fields every branch and every Fail state reads, so a failure in the first API call cannot raise States.Runtime while reporting itself.",
      "Assign": {
        "mode": "unset",
        "hsmPoll": 0,
        "ssmPoll": 0,
        "commandPoll": 0,
        "teardownPoll": 0,
        "backupPoll": 0,
        "preDeleteBaselineId": "none"
      },
      "Next": "AcquireClusterLease"
    },
    "AcquireClusterLease": {
      "Type": "Task",
      "Comment": "One conditional lease per cluster, owned by this execution. Without it two bootstrap/rotation runs can create duplicate HSMs and overwrite the same CA artifacts. The lease is reclaimed when its owner execution reaches a terminal state, so an aborted or timed-out run cannot block the cluster forever.",
      "Resource": "arn:aws:states:::aws-sdk:dynamodb:putItem",
      "Parameters": {
        "TableName": "${lease_table}",
        "Item": {
          "lease_id": { "S": "${cluster_id}" },
          "owner_arn": { "S.$": "$$.Execution.Id" },
          "acquired_at": { "S.$": "$$.State.EnteredTime" }
        },
        "ConditionExpression": "attribute_not_exists(lease_id) OR owner_arn = :owner",
        "ExpressionAttributeValues": {
          ":owner": { "S.$": "$$.Execution.Id" }
        }
      },
      "ResultPath": "$.leaseAcquired",
      "Retry": [
        {
          "ErrorEquals": ["DynamoDB.ProvisionedThroughputExceededException"],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2.0
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.leaseError",
          "Next": "DescribeLeaseOwner"
        }
      ],
      "Next": "DescribeCluster"
    },
    "DescribeLeaseOwner": {
      "Type": "Task",
      "Comment": "Read the conflicting lease so its owner's execution status can decide whether it is stale.",
      "Resource": "arn:aws:states:::aws-sdk:dynamodb:getItem",
      "Parameters": {
        "TableName": "${lease_table}",
        "Key": { "lease_id": { "S": "${cluster_id}" } },
        "ConsistentRead": true
      },
      "ResultPath": "$.lease",
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.leaseLookupError",
          "Next": "StealClusterLease"
        }
      ],
      "Next": "DescribeLeaseExecution"
    },
    "DescribeLeaseExecution": {
      "Type": "Task",
      "Comment": "A lease whose owner is no longer running is stale; a running owner means a genuine concurrent ceremony.",
      "Resource": "arn:aws:states:::aws-sdk:sfn:describeExecution",
      "Parameters": {
        "ExecutionArn.$": "$.lease.Item.owner_arn.S"
      },
      "ResultPath": "$.leaseExecution",
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.leaseExecutionError",
          "Next": "StealClusterLease"
        }
      ],
      "Next": "IsLeaseStale"
    },
    "IsLeaseStale": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.leaseExecution.status",
          "StringEquals": "RUNNING",
          "Next": "FailClusterBusy"
        },
        {
          "Variable": "$.leaseExecution.status",
          "StringEquals": "WAITING",
          "Next": "FailClusterBusy"
        }
      ],
      "Default": "StealClusterLease"
    },
    "StealClusterLease": {
      "Type": "Task",
      "Comment": "Reclaim a lease left by a terminal execution, then retry the conditional acquire.",
      "Resource": "arn:aws:states:::aws-sdk:dynamodb:deleteItem",
      "Parameters": {
        "TableName": "${lease_table}",
        "Key": { "lease_id": { "S": "${cluster_id}" } }
      },
      "ResultPath": "$.leaseStolen",
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.leaseStealError",
          "Next": "FailClusterBusy"
        }
      ],
      "Next": "AcquireClusterLease"
    },
    "FailClusterBusy": {
      "Type": "Fail",
      "Error": "ClusterBusy",
      "Cause": "Another ceremony execution still holds this cluster's lease. Wait for it to finish or reconcile it before starting a new run."
    },
    "DescribeCluster": {
      "Type": "Task",
      "Comment": "Infer the mode from whether this cluster has ever been initialized.",
      "Resource": "arn:aws:states:::aws-sdk:cloudhsmv2:describeClusters",
      "Parameters": {
        "Filters": {
          "clusterIds": ["${cluster_id}"]
        }
      },
      "ResultPath": "$.cluster",
      "Retry": [
        {
          "ErrorEquals": ["CloudHSMV2.ThrottlingException", "States.TaskFailed"],
          "IntervalSeconds": 5,
          "MaxAttempts": 6,
          "BackoffRate": 2.0
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.error",
          "Next": "CleanupHsmOnFailure"
        }
      ],
      "Next": "ListBackups"
    },
    "ListBackups": {
      "Type": "Task",
      "Comment": "SortAscending=false puts the newest backup at index 0; that is what a rotation restores from.",
      "Resource": "arn:aws:states:::aws-sdk:cloudhsmv2:describeBackups",
      "Parameters": {
        "Filters": {
          "clusterIds": ["${cluster_id}"]
        },
        "SortAscending": false
      },
      "ResultPath": "$.backups",
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.error",
          "Next": "CleanupHsmOnFailure"
        }
      ],
      "Next": "HasBaselineBackup"
    },
    "HasBaselineBackup": {
      "Type": "Choice",
      "Comment": "Snapshot the newest backup id before this run allocates anything. The escrow check must see a NEW backup, not this baseline.",
      "Choices": [
        {
          "Variable": "$.backups.Backups[0].BackupId",
          "IsPresent": true,
          "Next": "SetBackupBaseline"
        }
      ],
      "Default": "SetNoBaseline"
    },
    "SetBackupBaseline": {
      "Type": "Pass",
      "Parameters": {
        "createdAt.$": "$.backups.Backups[0].CreateTimestamp"
      },
      "ResultPath": "$.baseline",
      "Next": "ChooseMode"
    },
    "SetNoBaseline": {
      "Type": "Pass",
      "Result": {
        "createdAt": "1970-01-01T00:00:00Z"
      },
      "ResultPath": "$.baseline",
      "Next": "ChooseMode"
    },
    "ChooseMode": {
      "Type": "Choice",
      "Comment": "An explicit {\"mode\":\"BOOTSTRAP\"|\"ROTATE_INTERMEDIATE\"} in the execution input wins; otherwise infer it from the cluster state.",
      "Choices": [
%{ if bootstrap_enabled }
        {
          "And": [
            {
              "Variable": "$.mode",
              "IsPresent": true
            },
            {
              "Variable": "$.mode",
              "StringEquals": "BOOTSTRAP"
            }
          ],
          "Next": "SetBootstrapMode"
        },
%{ endif }
        {
          "And": [
            {
              "Variable": "$.mode",
              "IsPresent": true
            },
            {
              "Variable": "$.mode",
              "StringEquals": "ROTATE_INTERMEDIATE"
            }
          ],
          "Next": "SetRotateModeRequested"
        },
%{ if bootstrap_enabled }
        {
          "Comment": "Never initialized: no key material exists, so this run creates the Root CA.",
          "Variable": "$.cluster.Clusters[0].State",
          "StringEquals": "UNINITIALIZED",
          "Next": "SetBootstrapMode"
        },
%{ endif }
        {
          "Comment": "A mode was supplied but is not one of the two values: refuse rather than guess.",
          "And": [
            {
              "Variable": "$.mode",
              "IsPresent": true
            },
            {
              "Not": {
                "Variable": "$.mode",
                "StringEquals": "unset"
              }
            }
          ],
          "Next": "RecordInvalidMode"
        }
      ],
      "Default": "RequireReadyBackupInferred"
    },
%{ if bootstrap_enabled }
    "SetBootstrapMode": {
      "Type": "Pass",
      "Assign": {
        "mode": "BOOTSTRAP"
      },
      "Next": "CreateHsmNoBackup"
    },
%{ endif }
    "SetRotateModeRequested": {
      "Type": "Pass",
      "Comment": "Requested explicitly: still require a READY backup before restoring it.",
      "Assign": {
        "mode": "ROTATE_INTERMEDIATE"
      },
      "Next": "RequireReadyBackupRequested"
    },
    "RequireReadyBackupInferred": {
      "Type": "Pass",
      "Assign": {
        "mode": "ROTATE_INTERMEDIATE"
      },
      "Next": "RequireReadyBackupRequested"
    },
    "RequireReadyBackupRequested": {
      "Type": "Choice",
      "Comment": "Rotation restores the existing Root key, so a READY backup must exist. Never create an HSM without one: that would produce an empty HSM and a Root key nobody can restore.",
      "Choices": [
        {
          "And": [
            {
              "Variable": "$.backups.Backups[0].BackupId",
              "IsPresent": true
            },
            {
              "Variable": "$.backups.Backups[0].BackupState",
              "StringEquals": "READY"
            }
          ],
          "Next": "CreateHsmFromBackup"
        }
      ],
      "Default": "RecordNoReadyBackup"
    },
%{ if bootstrap_enabled }
    "CreateHsmNoBackup": {
      "Type": "Task",
      "Resource": "arn:aws:states:::aws-sdk:cloudhsmv2:createHsm",
      "Parameters": {
        "ClusterId": "${cluster_id}",
        "AvailabilityZone": "${availability_zone}"
      },
      "ResultPath": "$.hsm",
      "Retry": [
        {
          "ErrorEquals": ["CloudHSMV2.ThrottlingException"],
          "IntervalSeconds": 10,
          "MaxAttempts": 6,
          "BackoffRate": 2.0
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.error",
          "Next": "CleanupHsmOnFailure"
        }
      ],
      "Next": "CheckHsmState"
    },
%{ endif }
    "CreateHsmFromBackup": {
      "Type": "Task",
      "Comment": "CreateHsm takes only ClusterId and AvailabilityZone. Because this cluster has a backup, CloudHSM restores the cluster's most recent backup onto the new HSM — SourceBackupId exists only on CreateCluster, never here. VerifyBackupForRotation has already proved a READY backup exists.",
      "Resource": "arn:aws:states:::aws-sdk:cloudhsmv2:createHsm",
      "Parameters": {
        "ClusterId": "${cluster_id}",
        "AvailabilityZone": "${availability_zone}"
      },
      "ResultPath": "$.hsm",
      "Retry": [
        {
          "ErrorEquals": ["CloudHSMV2.ThrottlingException"],
          "IntervalSeconds": 10,
          "MaxAttempts": 6,
          "BackoffRate": 2.0
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.error",
          "Next": "CleanupHsmOnFailure"
        }
      ],
      "Next": "CheckHsmState"
    },
    "CheckHsmState": {
      "Type": "Task",
      "Comment": "The cluster stays INITIALIZED until the ceremony activates it, so poll the HSM's own state.",
      "Resource": "arn:aws:states:::aws-sdk:cloudhsmv2:describeClusters",
      "Parameters": {
        "Filters": {
          "clusterIds": ["${cluster_id}"]
        }
      },
      "ResultPath": "$.hsmState",
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.error",
          "Next": "CleanupHsmOnFailure"
        }
      ],
      "Next": "IsHsmActive"
    },
    "IsHsmActive": {
      "Type": "Choice",
      "Choices": [
        {
          "And": [
            {
              "Variable": "$.hsmState.Clusters[0].Hsms[0].HsmId",
              "IsPresent": true
            },
            {
              "Variable": "$.hsmState.Clusters[0].Hsms[0].HsmId",
              "StringEqualsPath": "$.hsm.Hsm.HsmId"
            },
            {
              "Variable": "$.hsmState.Clusters[0].Hsms[0].State",
              "StringEquals": "ACTIVE"
            },
            {
              "Variable": "$.hsmState.Clusters[0].Hsms[0].EniIp",
              "IsPresent": true
            },
            {
              "Variable": "$.hsmState.Clusters[0].Hsms[0].EniIp",
              "StringMatches": "*.*.*.*"
            }
          ],
          "Next": "LaunchCeremonyHost"
        }
      ],
      "Default": "GuardHsmPolls"
    },
    "GuardHsmPolls": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$hsmPoll",
          "NumericLessThan": 90,
          "Next": "WaitForHsm"
        }
      ],
      "Default": "RecordHsmNotReady"
    },
    "WaitForHsm": {
      "Type": "Wait",
      "Seconds": 60,
      "Next": "IncrementHsmPoll"
    },
    "IncrementHsmPoll": {
      "Type": "Pass",
      "Assign": {
        "hsmPoll.$": "States.MathAdd($hsmPoll, 1)"
      },
      "Next": "CheckHsmState"
    },
    "LaunchCeremonyHost": {
      "Type": "Task",
      "Comment": "Ephemeral, no inbound rules; the workflow drives it through SSM only.",
      "Resource": "arn:aws:states:::aws-sdk:ec2:runInstances",
      "Parameters": {
        "ImageId": "${ami_id}",
        "InstanceType": "${instance_type}",
        "MinCount": 1,
        "MaxCount": 1,
        "SubnetId": "${subnet_id}",
        "SecurityGroupIds": ["${ceremony_security_group_id}"],
        "IamInstanceProfile": {
          "Arn": "${instance_profile_arn}"
        },
        "MetadataOptions": {
          "HttpTokens": "required",
          "HttpEndpoint": "enabled",
          "HttpPutResponseHopLimit": 1
        },
        "BlockDeviceMappings": [
          {
            "DeviceName": "/dev/xvda",
            "Ebs": {
              "VolumeSize": 30,
              "VolumeType": "gp3",
              "Encrypted": true,
              "DeleteOnTermination": true
            }
          }
        ],
        "TagSpecifications": [
          {
            "ResourceType": "instance",
            "Tags": [
              {
                "Key": "Name",
                "Value": "${name}-ceremony-host"
              },
              {
                "Key": "Purpose",
                "Value": "cloudhsmca-root-ceremony"
              }
            ]
          }
        ]
      },
      "ResultPath": "$.host",
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.error",
          "Next": "CleanupHsmOnFailure"
        }
      ],
      "Next": "DescribeSsmInstance"
    },
    "DescribeSsmInstance": {
      "Type": "Task",
      "Comment": "EC2 'running' precedes SSM agent registration; sendCommand would fail with InvalidInstanceId.",
      "Resource": "arn:aws:states:::aws-sdk:ssm:describeInstanceInformation",
      "Parameters": {
        "Filters": [
          {
            "Key": "InstanceIds",
            "Values.$": "States.Array($.host.Instances[0].InstanceId)"
          }
        ]
      },
      "ResultPath": "$.ssm",
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.error",
          "Next": "CleanupHsmOnFailure"
        }
      ],
      "Next": "IsSsmOnline"
    },
    "IsSsmOnline": {
      "Type": "Choice",
      "Choices": [
        {
          "And": [
            {
              "Variable": "$.ssm.InstanceInformationList[0].PingStatus",
              "IsPresent": true
            },
            {
              "Variable": "$.ssm.InstanceInformationList[0].PingStatus",
              "StringEquals": "Online"
            }
          ],
          "Next": "ChooseCeremonyScript"
        }
      ],
      "Default": "GuardSsmPolls"
    },
    "GuardSsmPolls": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$ssmPoll",
          "NumericLessThan": 60,
          "Next": "WaitForSsm"
        }
      ],
      "Default": "RecordSsmNotReady"
    },
    "WaitForSsm": {
      "Type": "Wait",
      "Seconds": 15,
      "Next": "IncrementSsmPoll"
    },
    "IncrementSsmPoll": {
      "Type": "Pass",
      "Assign": {
        "ssmPoll.$": "States.MathAdd($ssmPoll, 1)"
      },
      "Next": "DescribeSsmInstance"
    },
    "ChooseCeremonyScript": %{ if bootstrap_enabled }{
      "Type": "Choice",
      "Comment": "Route by the resolved mode (a workflow variable set by the mode states), not by the raw execution input.",
      "Choices": [
        {
          "Variable": "$mode",
          "StringEquals": "BOOTSTRAP",
          "Next": "RunBootstrapCeremony"
        }
      ],
      "Default": "RunRotationCeremony"
    }%{ else }{
      "Type": "Pass",
      "Comment": "Bootstrap is disabled: this deployment is rotation-only.",
      "Next": "RunRotationCeremony"
    }%{ endif },
%{ if bootstrap_enabled }
    "RunBootstrapCeremony": {
      "Type": "Task",
      "Comment": "Claims an UNINITIALIZED cluster (InitializeCluster), activates it, generates the non-exportable Root key, self-signs the Root CA and signs the Intermediate.",
      "Resource": "arn:aws:states:::aws-sdk:ssm:sendCommand",
      "Parameters": {
        "InstanceIds.$": "States.Array($.host.Instances[0].InstanceId)",
        "DocumentName": "AWS-RunShellScript",
        "Comment": "${name} bootstrap ceremony",
        "TimeoutSeconds": 3600,
        "Parameters": {
          "executionTimeout": ["3600"],
          "commands.$": "States.Array('set -euo pipefail', 'mkdir -p /opt/ceremony', States.Format('export CEREMONY_HSM_IP={}', $.hsmState.Clusters[0].Hsms[0].EniIp), 'export CEREMONY_MODE=BOOTSTRAP', States.Format('aws s3api get-object --bucket ${bucket} --key ${bootstrap_key} /opt/ceremony/bootstrap.sh'), 'bash /opt/ceremony/bootstrap.sh 2>&1 | tee -a /var/log/ceremony.log')"
        }
      },
      "ResultPath": "$.command",
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.error",
          "Next": "CleanupHsmOnFailure"
        }
      ],
      "Next": "PollCommandInvocation"
    },
%{ endif }
    "RunRotationCeremony": {
      "Type": "Task",
      "Comment": "Signs a new Intermediate CSR with the restored Root key. No Root generation, no re-activation.",
      "Resource": "arn:aws:states:::aws-sdk:ssm:sendCommand",
      "Parameters": {
        "InstanceIds.$": "States.Array($.host.Instances[0].InstanceId)",
        "DocumentName": "AWS-RunShellScript",
        "Comment": "${name} intermediate rotation",
        "TimeoutSeconds": 3600,
        "Parameters": {
          "executionTimeout": ["3600"],
          "commands.$": "States.Array('set -euo pipefail', 'mkdir -p /opt/ceremony', States.Format('export CEREMONY_HSM_IP={}', $.hsmState.Clusters[0].Hsms[0].EniIp), 'export CEREMONY_MODE=ROTATE_INTERMEDIATE', States.Format('aws s3api get-object --bucket ${bucket} --key ${rotate_key} /opt/ceremony/rotate.sh'), 'bash /opt/ceremony/rotate.sh 2>&1 | tee -a /var/log/ceremony.log')"
        }
      },
      "ResultPath": "$.command",
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.error",
          "Next": "CleanupHsmOnFailure"
        }
      ],
      "Next": "PollCommandInvocation"
    },
    "PollCommandInvocation": {
      "Type": "Task",
      "Comment": "The command id exists before GetCommandInvocation can see the invocation; retry only that documented eventual-consistency condition. Every other error is permanent and goes through cleanup.",
      "Resource": "arn:aws:states:::aws-sdk:ssm:getCommandInvocation",
      "Parameters": {
        "CommandId.$": "$.command.Command.CommandId",
        "InstanceId.$": "$.host.Instances[0].InstanceId"
      },
      "ResultPath": "$.invocation",
      "Retry": [
        {
          "ErrorEquals": ["Ssm.InvocationDoesNotExistException", "SSM.InvocationNotFound"],
          "IntervalSeconds": 5,
          "MaxAttempts": 12,
          "BackoffRate": 1.5
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.error",
          "Next": "CleanupHsmOnFailure"
        }
      ],
      "Next": "IsCommandFinished"
    },
    "IsCommandFinished": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.invocation.Status",
          "StringEquals": "Success",
          "Next": "RecordCeremonyResult"
        },
        {
          "Or": [
            {
              "Variable": "$.invocation.Status",
              "StringEquals": "Failed"
            },
            {
              "Variable": "$.invocation.Status",
              "StringEquals": "TimedOut"
            },
            {
              "Variable": "$.invocation.Status",
              "StringEquals": "Cancelled"
            }
          ],
          "Next": "RecordCeremonyCommandFailure"
        }
      ],
      "Default": "GuardCommandPolls"
    },
    "GuardCommandPolls": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$commandPoll",
          "NumericLessThan": 240,
          "Next": "WaitForCommand"
        }
      ],
      "Default": "RecordCommandTimeout"
    },
    "WaitForCommand": {
      "Type": "Wait",
      "Seconds": 20,
      "Next": "IncrementCommandPoll"
    },
    "IncrementCommandPoll": {
      "Type": "Pass",
      "Assign": {
        "commandPoll.$": "States.MathAdd($commandPoll, 1)"
      },
      "Next": "PollCommandInvocation"
    },
    "RecordCeremonyResult": {
      "Type": "Pass",
      "Comment": "Keeps the ceremony's transcript in the execution history and in the success payload.",
      "Assign": {
        "ceremonyOutput": "$.invocation.StandardOutputContent"
      },
      "Next": "VerifyChainPublished"
    },
    "VerifyChainPublished": {
      "Type": "Task",
      "Comment": "Read the published bundle back before the HSM is deleted: an escrow backup is worthless if the chain it protects never reached SSM.",
      "Resource": "arn:aws:states:::aws-sdk:ssm:getParameter",
      "Parameters": {
        "Name": "${ca_bundle_ssm_pem}"
      },
      "ResultPath": "$.publishedBundle",
      "Retry": [
        {
          "ErrorEquals": ["States.TaskFailed", "Ssm.ThrottlingException"],
          "IntervalSeconds": 5,
          "MaxAttempts": 3,
          "BackoffRate": 2.0
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.error",
          "Next": "CleanupHsmOnFailure"
        }
      ],
      "Next": "IsChainPublished"
    },
    "IsChainPublished": {
      "Type": "Choice",
      "Choices": [
        {
          "And": [
            {
              "Variable": "$.publishedBundle.Parameter.Value",
              "IsPresent": true
            },
            {
              "Variable": "$.publishedBundle.Parameter.Value",
              "StringMatches": "*BEGIN CERTIFICATE*"
            },
            {
              "Variable": "$.publishedBundle.Parameter.Value",
              "StringMatches": "*-END CERTIFICATE-*"
            }
          ],
          "Next": "RecordPreDeleteBackups"
        }
      ],
      "Default": "RecordChainNotPublished"
    },
    "RecordChainNotPublished": {
      "Type": "Pass",
      "Comment": "The chain is missing or still the PENDING placeholder. Keep the HSM: it holds the only copy of the Root key.",
      "Result": {
        "Error": "ChainNotPublished",
        "Cause": "SSM ca_bundle.pem is missing or still the PENDING placeholder. The HSM was kept because it holds the only copy of the Root key."
      },
      "ResultPath": "$.error",
      "Next": "CleanupHostOnFailure"
    },
    "RecordPreDeleteBackups": {
      "Type": "Task",
      "Comment": "Snapshot the newest backup id immediately before deletion so the escrow gate accepts only the backup this deletion creates.",
      "Resource": "arn:aws:states:::aws-sdk:cloudhsmv2:describeBackups",
      "Parameters": {
        "Filters": {
          "clusterIds": ["${cluster_id}"]
        },
        "SortAscending": false
      },
      "ResultPath": "$.preDeleteBackups",
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.error",
          "Next": "CleanupHsmOnFailure"
        }
      ],
      "Next": "ChoosePreDeleteBaseline"
    },
    "ChoosePreDeleteBaseline": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.preDeleteBackups.Backups[0].BackupId",
          "IsPresent": true,
          "Next": "SetPreDeleteBaseline"
        }
      ],
      "Default": "SetNoPreDeleteBaseline"
    },
    "SetPreDeleteBaseline": {
      "Type": "Pass",
      "Assign": {
        "preDeleteBaselineId.$": "$.preDeleteBackups.Backups[0].BackupId"
      },
      "Next": "DeleteHsmForEscrow"
    },
    "SetNoPreDeleteBaseline": {
      "Type": "Pass",
      "Comment": "No backup existed before this run, so any READY backup afterwards is the one the deletion created.",
      "Assign": {
        "preDeleteBaselineId": "none"
      },
      "Next": "DeleteHsmForEscrow"
    },
    "DeleteHsmForEscrow": {
      "Type": "Task",
      "Comment": "DeleteHsm triggers the cluster backup in the CloudHSM backup lifecycle and drops billing to zero; the backup itself appears asynchronously and is polled below.",
      "Resource": "arn:aws:states:::aws-sdk:cloudhsmv2:deleteHsm",
      "Parameters": {
        "ClusterId": "${cluster_id}",
        "HsmId.$": "$.hsm.Hsm.HsmId"
      },
      "ResultPath": "$.deletedHsm",
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.deleteHsmError",
          "Next": "RecordHsmDeleteFailure"
        }
      ],
      "Next": "PollHsmGone"
    },
    "RecordHsmDeleteFailure": {
      "Type": "Pass",
      "Comment": "The escrow backup is already READY, so the key is safe; report the deletion failure without deleting anything else.",
      "Parameters": {
        "Error.$": "$.deleteHsmError.Error",
        "Cause.$": "$.deleteHsmError.Cause"
      },
      "ResultPath": "$.error",
      "Next": "CleanupHsmOnFailure"
    },
    "PollHsmGone": {
      "Type": "Task",
      "Comment": "The API returns before the HSM is actually gone; the ENI and the billing stop only at deletion.",
      "Resource": "arn:aws:states:::aws-sdk:cloudhsmv2:describeClusters",
      "Parameters": {
        "Filters": {
          "clusterIds": ["${cluster_id}"]
        }
      },
      "ResultPath": "$.teardown",
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.teardownError",
          "Next": "RecordTeardownFailure"
        }
      ],
      "Next": "IsHsmGone"
    },
    "IsHsmGone": {
      "Type": "Choice",
      "Choices": [
        {
          "Comment": "No HSMs left in the cluster: deletion has completed.",
          "Variable": "$.teardown.Clusters[0].Hsms[0].HsmId",
          "IsPresent": false,
          "Next": "PollBackup"
        }
      ],
      "Default": "GuardTeardownPolls"
    },
    "GuardTeardownPolls": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$teardownPoll",
          "NumericLessThan": 60,
          "Next": "WaitForTeardown"
        }
      ],
      "Default": "RecordHsmDeletionIncomplete"
    },
    "WaitForTeardown": {
      "Type": "Wait",
      "Seconds": 30,
      "Next": "IncrementTeardownPoll"
    },
    "IncrementTeardownPoll": {
      "Type": "Pass",
      "Assign": {
        "teardownPoll.$": "States.MathAdd($teardownPoll, 1)"
      },
      "Next": "PollHsmGone"
    },
    "PollBackup": {
      "Type": "Task",
      "Comment": "The Root key is escrowed only once a READY backup exists. Never report success before this.",
      "Resource": "arn:aws:states:::aws-sdk:cloudhsmv2:describeBackups",
      "Parameters": {
        "Filters": {
          "clusterIds": ["${cluster_id}"]
        },
        "SortAscending": false
      },
      "ResultPath": "$.finalBackups",
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.backupError",
          "Next": "RecordBackupNotReady"
        }
      ],
      "Next": "IsBackupReady"
    },
    "IsBackupReady": {
      "Type": "Choice",
      "Comment": "BackupState is the field name in the CloudHSM Backup API, and the escrow backup must be a NEW one: a pre-existing backup cannot prove this run's Root material was written.",
      "Choices": [
        {
          "And": [
            {
              "Variable": "$.finalBackups.Backups[0].BackupState",
              "IsPresent": true
            },
            {
              "Variable": "$.finalBackups.Backups[0].BackupState",
              "StringEquals": "READY"
            },
            {
              "Variable": "$.finalBackups.Backups[0].BackupId",
              "IsPresent": true
            },
            {
              "Variable": "$.finalBackups.Backups[0].CreateTimestamp",
              "IsPresent": true
            },
            {
              "Variable": "$.finalBackups.Backups[0].CreateTimestamp",
              "TimestampGreaterThanPath": "$.baseline.createdAt"
            },
            {
              "Variable": "$.finalBackups.Backups[0].BackupId",
              "StringNotEqualsPath": "$.preDeleteBaselineId"
            }
          ],
          "Next": "RecordVerifiedBackup"
        }
      ],
      "Default": "GuardBackupPolls"
    },
    "RecordVerifiedBackup": {
      "Type": "Task",
      "Comment": "Commit the verified escrow id before the host is terminated or the chain is announced, so a consumer cannot activate against an unescrowed root.",
      "Resource": "arn:aws:states:::aws-sdk:ssm:putParameter",
      "Parameters": {
        "Name": "${verified_backup_param}",
        "Value.$": "$.finalBackups.Backups[0].BackupId",
        "Type": "String",
        "Overwrite": true
      },
      "ResultPath": "$.verifiedBackup",
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.error",
          "Next": "CleanupHostOnFailure"
        }
      ],
      "Next": "TerminateHostAfterSuccess"
    },
    "ReleaseClusterLease": {
      "Type": "Task",
      "Comment": "Best-effort release after the escrow is verified and the host is gone; a failed release leaves a lease that the next run reclaims from its terminal owner.",
      "Resource": "arn:aws:states:::aws-sdk:dynamodb:deleteItem",
      "Parameters": {
        "TableName": "${lease_table}",
        "Key": { "lease_id": { "S": "${cluster_id}" } },
        "ConditionExpression": "owner_arn = :owner",
        "ExpressionAttributeValues": {
          ":owner": { "S.$": "$$.Execution.Id" }
        }
      },
      "ResultPath": "$.leaseReleased",
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.leaseReleaseError",
          "Next": "PublishCaReadyEvent"
        }
      ],
      "Next": "PublishCaReadyEvent"
    },
    "GuardBackupPolls": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$backupPoll",
          "NumericLessThan": ${escrow_polls},
          "Next": "WaitForBackup"
        }
      ],
      "Default": "RecordBackupNotReady"
    },
    "WaitForBackup": {
      "Type": "Wait",
      "Seconds": 60,
      "Next": "IncrementBackupPoll"
    },
    "IncrementBackupPoll": {
      "Type": "Pass",
      "Assign": {
        "backupPoll.$": "States.MathAdd($backupPoll, 1)"
      },
      "Next": "PollBackup"
    },
    "TerminateHostAfterSuccess": {
      "Type": "Task",
      "Resource": "arn:aws:states:::aws-sdk:ec2:terminateInstances",
      "Parameters": {
        "InstanceIds.$": "States.Array($.host.Instances[0].InstanceId)"
      },
      "ResultPath": "$.hostTerminated",
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.terminateError",
          "Next": "RecordHostTerminateFailure"
        }
      ],
      "Next": "ReleaseClusterLease"
    },
    "PublishCaReadyEvent": {
      "Type": "Task",
      "Comment": "Announce the published chain. The optimized EventBridge integration takes Detail as an object and raises EventBridge.FailedEntry when AWS drops the entry, unlike the aws-sdk integration which returns 200 with FailedEntryCount=1.",
      "Resource": "arn:aws:states:::events:putEvents",
      "Parameters": {
        "Entries": [
          {
            "EventBusName": "${event_bus_name}",
            "Source": "cloudhsmca.pki",
            "DetailType": "CAChainPublished",
            "Detail": {
              "ca_name": "${ca_name}",
              "cluster_id": "${cluster_id_out}",
              "intermediate_kms_key_arn": "${kms_key_arn_out}",
              "ca_bundle_ssm_param": "${ca_bundle_ssm_pem}",
              "root_ca_ssm_param": "${root_ca_ssm_pem}",
              "intermediate_ca_ssm_param": "${intermediate_ssm_pem}",
              "verified_backup_ssm_param": "${verified_backup_param}",
              "verified_backup_id.$": "$.finalBackups.Backups[0].BackupId",
              "artifacts_bucket": "${bucket_out}"
            }
          }
        ]
      },
      "ResultPath": "$.eventResult",
      "Retry": [
        {
          "ErrorEquals": ["EventBridge.FailedEntry", "Events.InternalException", "States.TaskFailed"],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2.0
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.error",
          "Next": "FailCaEventPublish"
        }
      ],
      "Next": "CeremonySucceeded"
    },
    "FailCaEventPublish": {
      "Type": "Fail",
      "Comment": "Publish runs after the host is terminated and the backup is READY, so there is nothing left to tear down: report the publish failure directly instead of routing through cleanup, which would delete an already-deleted HSM and terminate an already-terminated host.",
      "Error": "CaEventPublishFailed",
      "CausePath": "States.Format('chain published to SSM and the HSM is gone, but CAChainPublished was not emitted: {} | mode={} : {}', $.error.Error, $mode, $.error.Cause)"
    },
    "CeremonySucceeded": {
      "Type": "Succeed"
    },
    "CleanupHsmOnFailure": {
      "Type": "Pass",
      "Comment": "Never delete the HSM on failure. It may hold the only copy of the Root key, and the backup is not proven until it is READY. Terminate the host, report, and delete the HSM only after a backup exists.",
      "Next": "CleanupHostOnFailure"
    },
    "CleanupHostOnFailure": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.host.Instances[0].InstanceId",
          "IsPresent": true,
          "Next": "TerminateHostOnFailure"
        }
      ],
      "Default": "ReleaseClusterLeaseOnFailure"
    },
    "TerminateHostOnFailure": {
      "Type": "Task",
      "Resource": "arn:aws:states:::aws-sdk:ec2:terminateInstances",
      "Parameters": {
        "InstanceIds.$": "States.Array($.host.Instances[0].InstanceId)"
      },
      "ResultPath": "$.cleanupHost",
      "Retry": [
        {
          "ErrorEquals": ["States.ALL"],
          "IntervalSeconds": 10,
          "MaxAttempts": 3,
          "BackoffRate": 2.0
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.cleanupHostError",
          "Next": "ReleaseClusterLeaseOnFailure"
        }
      ],
      "Next": "ReleaseClusterLeaseOnFailure"
    },
    "ReleaseClusterLeaseOnFailure": {
      "Type": "Task",
      "Comment": "Release the lease only after the HSM and host cleanup have been attempted. The original error survives in $.error; this task never writes it.",
      "Resource": "arn:aws:states:::aws-sdk:dynamodb:deleteItem",
      "Parameters": {
        "TableName": "${lease_table}",
        "Key": { "lease_id": { "S": "${cluster_id}" } },
        "ConditionExpression": "owner_arn = :owner",
        "ExpressionAttributeValues": {
          ":owner": { "S.$": "$$.Execution.Id" }
        }
      },
      "ResultPath": "$.leaseReleased",
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.leaseReleaseError",
          "Next": "FailOriginalCause"
        }
      ],
      "Next": "FailOriginalCause"
    },
    "FailOriginalCause": {
      "Type": "Fail",
      "Comment": "Cleanup finished: re-raise the error that started it, never the cleanup outcome.",
      "Error": "CeremonyFailed",
      "CausePath": "States.Format('{} | mode={} : {}', $.error.Error, $mode, $.error.Cause)"
    },
    "RecordInvalidMode": {
      "Type": "Pass",
      "Parameters": {
        "Error": "InvalidMode",
        "Cause.$": "States.Format('mode must be BOOTSTRAP or ROTATE_INTERMEDIATE, got {}', $.mode)"
      },
      "ResultPath": "$.error",
      "Next": "ReleaseClusterLeaseOnFailure"
    },
    "RecordNoReadyBackup": {
      "Type": "Pass",
      "Result": {
        "Error": "NoReadyBackup",
        "Cause": "The cluster is initialized but has no READY backup to restore the Root key from. A rotation that created an HSM without one would start from an empty HSM and lose the Root CA."
      },
      "ResultPath": "$.error",
      "Next": "ReleaseClusterLeaseOnFailure"
    },
    "RecordHsmNotReady": {
      "Type": "Pass",
      "Result": {
        "Error": "HsmNotReady",
        "Cause": "The HSM did not reach ACTIVE within 90 polls (about 90 minutes)."
      },
      "ResultPath": "$.error",
      "Next": "CleanupHsmOnFailure"
    },
    "RecordSsmNotReady": {
      "Type": "Pass",
      "Result": {
        "Error": "SsmAgentNotOnline",
        "Cause": "The ceremony host never reported PingStatus Online (60 polls, 15 minutes). Check the instance profile and the ssm/ssmmessages endpoints."
      },
      "ResultPath": "$.error",
      "Next": "CleanupHsmOnFailure"
    },
    "RecordCeremonyCommandFailure": {
      "Type": "Pass",
      "Parameters": {
        "Error": "CeremonyCommandFailed",
        "Cause.$": "States.JsonToString($.invocation)"
      },
      "ResultPath": "$.error",
      "Next": "CleanupHsmOnFailure"
    },
    "RecordCommandTimeout": {
      "Type": "Pass",
      "Result": {
        "Error": "CeremonyCommandTimedOut",
        "Cause": "No terminal command status after 240 polls (80 minutes)."
      },
      "ResultPath": "$.error",
      "Next": "CleanupHsmOnFailure"
    },
    "RecordTeardownFailure": {
      "Type": "Pass",
      "Parameters": {
        "Error": "TeardownCheckFailed",
        "Cause.$": "States.Format('could not confirm the HSM was deleted: {}', $.teardownError.Cause)"
      },
      "ResultPath": "$.error",
      "Next": "CleanupHsmOnFailure"
    },
    "RecordHsmDeletionIncomplete": {
      "Type": "Pass",
      "Result": {
        "Error": "HsmDeletionIncomplete",
        "Cause": "The HSM was asked to delete but is still present after 30 minutes: check the CloudHSM backup quota and the cluster state before assuming the billing stopped."
      },
      "ResultPath": "$.error",
      "Next": "CleanupHsmOnFailure"
    },
    "RecordBackupNotReady": {
      "Type": "Pass",
      "Comment": "The HSM is already deleted; without a backup the Root key is gone, so this must fail loudly rather than report success.",
      "Result": {
        "Error": "BackupNotReady",
        "Cause": "The HSM was deleted but no READY escrow backup appeared within 60 minutes. The Root key may not be escrowed: check describe-backups before re-running."
      },
      "ResultPath": "$.error",
      "Next": "CleanupHostOnFailure"
    },
    "RecordHostTerminateFailure": {
      "Type": "Pass",
      "Parameters": {
        "Error": "HostTerminateFailed",
        "Cause.$": "States.Format('ceremony succeeded and the HSM is gone, but the host could not be terminated: {}', $.terminateError.Cause)"
      },
      "ResultPath": "$.error",
      "Next": "CleanupHostOnFailure"
    }
  }
}
